# Configuration Dz-Fleet AI — Système Souverain de Gestion de Flotte

# Environnement et Port
PORT=3000
NODE_ENV=production

# URL publique de l'application (ex: https://dz-fleet-dev.onrender.com)
APP_URL=https://dz-fleet-dev.onrender.com

# Base de Données PostgreSQL (Neon.tech en Dev ou Datacenter National en Prod)
DATABASE_URL=postgres://user:password@ep-xyz.neon.tech/dzfleet?sslmode=require

# Configuration Messagerie SMTP (Mailtrap pour le test sandbox, ou Brevo / SMTP Entreprise)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=Dz-Fleet AI <notifications@dzfleet.dz>

# Clé API optionnelle pour la vision IA (l'application fonctionne 100% en autonome avec le moteur OCR souverain local)
GEMINI_API_KEY=
